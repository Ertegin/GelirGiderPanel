@model GelirGiderPanel.Models.Transaction
@{
    ViewData["Title"] = "Yeni İşlem";
}

<h1 class="h3 mb-4">Yeni Gelir / Gider Ekle</h1>

<div class="card" style="max-width: 640px;">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="TransactionTypeId" class="form-label"></label>
                    <select asp-for="TransactionTypeId" asp-items="ViewBag.TransactionTypes" class="form-select">
                        <option value="">-- Tür Seçin --</option>
                    </select>
                    <span asp-validation-for="TransactionTypeId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="CategoryId" class="form-label"></label>
                    <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                        <option value="">-- Kategori Seçin --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Amount" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="Amount" type="number" step="0.01" min="0.01"
                               class="form-control" placeholder="0,00" />
                        <span class="input-group-text">₺</span>
                    </div>
                    <span asp-validation-for="Amount" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Date" class="form-label"></label>
                    <input asp-for="Date" type="date" class="form-control" />
                    <span asp-validation-for="Date" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <input asp-for="Description" class="form-control"
                           placeholder="Örn: Mutfak malzeme alımı, Gömlek satışı..." />
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i> Kaydet
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
