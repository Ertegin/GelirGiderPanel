@model GelirGiderPanel.ViewModels.ReportViewModel
@{
    ViewData["Title"] = "Raporlar";
    var today = DateTime.Today;
    var monthStart = new DateTime(today.Year, today.Month, 1);
    var prevMonthStart = monthStart.AddMonths(-1);
    var prevMonthEnd = monthStart.AddDays(-1);
    var yearStart = new DateTime(today.Year, 1, 1);
    string D(DateTime d) => d.ToString("yyyy-MM-dd");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Raporlar</h1>
        <p class="text-muted mb-0">
            @Model.StartDate.ToString("dd MMMM yyyy") – @Model.EndDate.ToString("dd MMMM yyyy") dönemi
        </p>
    </div>
    <div class="d-flex gap-2">
        @* Her iki dışa aktarma linki de seçili TÜM filtreleri taşır *@
        <a asp-action="ExportToPdf"
           asp-route-startDate="@D(Model.StartDate)"
           asp-route-endDate="@D(Model.EndDate)"
           asp-route-categoryId="@Model.CategoryId"
           asp-route-transactionTypeId="@Model.TransactionTypeId"
           class="btn btn-outline-danger">
            <i class="bi bi-file-earmark-pdf me-1"></i> PDF
        </a>
        <a asp-action="ExportToExcel"
           asp-route-startDate="@D(Model.StartDate)"
           asp-route-endDate="@D(Model.EndDate)"
           asp-route-categoryId="@Model.CategoryId"
           asp-route-transactionTypeId="@Model.TransactionTypeId"
           class="btn btn-primary">
            <i class="bi bi-file-earmark-excel me-1"></i> Excel'e Aktar
        </a>
    </div>
</div>

<!-- ======= FİLTRE ======= -->
<div class="card mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" id="filterForm" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Başlangıç Tarihi</label>
                <input type="date" id="startDate" name="startDate" value="@D(Model.StartDate)" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Bitiş Tarihi</label>
                <input type="date" id="endDate" name="endDate" value="@D(Model.EndDate)" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Kategori</label>
                <select name="categoryId" class="form-select" asp-items="ViewBag.Categories">
                    <option value="">Tüm Kategoriler</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Tür</label>
                <select name="transactionTypeId" class="form-select" asp-items="ViewBag.TransactionTypes">
                    <option value="">Gelir + Gider</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-dark w-100">
                    <i class="bi bi-funnel me-1"></i> Filtrele
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Filtreleri temizle">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>
            <div class="col-12">
                @* Hazır dönem butonları: tarihleri doldurup formu gönderir,
                   böylece seçili kategori ve tür filtreleri KORUNUR. *@
                <div class="btn-group" role="group" aria-label="Hazır dönemler">
                    <button type="button" class="btn btn-sm btn-outline-dark"
                            onclick="setRange('@D(monthStart)', '@D(today)')">
                        Bu Ay
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-dark"
                            onclick="setRange('@D(prevMonthStart)', '@D(prevMonthEnd)')">
                        Geçen Ay
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-dark"
                            onclick="setRange('@D(prevMonthStart)', '@D(today)')">
                        Geçen Ay + Bu Ay
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-dark"
                            onclick="setRange('@D(yearStart)', '@D(today)')">
                        Bu Yıl
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- ======= DÖNEM ÖZETİ ======= -->
<div class="row g-3 mb-4">
    @if (Model.CanViewTransactionDetails)
    {
        
    
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <p class="text-muted mb-1 small text-uppercase fw-semibold">Dönem Geliri</p>
                <h2 class="h4 text-income mb-0">@Model.TotalIncome.ToString("N2") ₺</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <p class="text-muted mb-1 small text-uppercase fw-semibold">Dönem Gideri</p>
                <h2 class="h4 text-expense mb-0">@Model.TotalExpense.ToString("N2") ₺</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <p class="text-muted mb-1 small text-uppercase fw-semibold">Dönem Net</p>
                <h2 class="h4 mb-0 @(Model.NetBalance >= 0 ? "text-income" : "text-expense")">
                    @Model.NetBalance.ToString("N2") ₺
                </h2>
            </div>
        </div>
    </div>
    }
</div>

<!-- ======= KATEGORİ DÖKÜMÜ ======= -->
<div class="card mb-4">
    <div class="card-body">
        @if (Model.CanViewTransactionDetails)
        {
            
        
        <h5 class="card-title mb-3">Kategori Dökümü</h5>
        @if (!Model.CategorySummary.Any())
        {
            <p class="text-muted mb-0">Seçilen dönemde işlem bulunamadı.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Kategori</th>
                            <th class="text-end">Gelir</th>
                            <th class="text-end">Gider</th>
                            <th class="text-end">Net</th>
                            <th class="text-center">İşlem Sayısı</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.CategorySummary)
                        {
                            <tr>
                                <td class="fw-semibold">@c.CategoryName</td>
                                <td class="text-end text-income">@c.Income.ToString("N2") ₺</td>
                                <td class="text-end text-expense">@c.Expense.ToString("N2") ₺</td>
                                <td class="text-end fw-semibold @(c.Net >= 0 ? "text-income" : "text-expense")">
                                    @c.Net.ToString("N2") ₺
                                </td>
                                <td class="text-center">@c.TransactionCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        }
        else
        {
            <h5 class="card-title mb-3">İşlem Detayları</h5>
            <div class="position-relative">
               
                <table class="table align-middle mb-0" style="filter: blur(6px); user-select: none;" aria-hidden="true">
                    <thead class="table-light">
                        <tr><th>Tarih</th><th>Açıklama</th><th>Kategori</th><th>Tür</th><th class="text-end">Tutar</th></tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < 5; i++)
                        {
                            <tr>
                                <td>00.00.0000</td>
                                <td>-----</td>
                                <td>-----</td>
                                <td><span class="badge rounded-pill bg-secondary">----</span></td>
                                <td class="text-end">0.000,00 ₺</td>
                            </tr>
                        }
                    </tbody>
                </table>

                
                <div class="position-absolute top-50 start-50 translate-middle text-center bg-white rounded-3 shadow-sm p-4">
                    <i class="bi bi-lock-fill fs-3" style="color:#b3423a;"></i>
                    <p class="mb-0 fw-semibold mt-2">İşlem detaylarını görüntüleme yetkiniz yok</p>
                    <small class="text-muted">Erişim için yöneticinizle iletişime geçin.</small>
                </div>
            </div>
        }

    </div>
</div>

<!-- ======= İŞLEM DETAYLARI ======= -->
<div class="card">
    <div class="card-body">
        @if (Model.CanViewTransactionDetails)
        {
           
        
        <h5 class="card-title mb-3">İşlem Detayları (@Model.Transactions.Count kayıt)</h5>
        @if (!Model.Transactions.Any())
        {
            <p class="text-muted mb-0">Seçilen dönemde işlem bulunamadı.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tarih</th>
                            <th>Açıklama</th>
                            <th>Kategori</th>
                            <th>Tür</th>
                            <th class="text-end">Tutar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.Transactions)
                        {
                            var isIncome = t.TransactionTypeId == 1;
                            <tr>
                                <td>@t.Date.ToString("dd.MM.yyyy")</td>
                                <td>@t.Description</td>
                                <td>@t.Category?.Name</td>
                                <td>
                                    <span class="badge rounded-pill @(isIncome ? "badge-income" : "badge-expense")">
                                        @t.TransactionType?.Name
                                    </span>
                                </td>
                                <td class="text-end fw-semibold @(isIncome ? "text-income" : "text-expense")">
                                    @(isIncome ? "+" : "-")@t.Amount.ToString("N2") ₺
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        }
        else
        {
            <h5 class="card-title mb-3">İşlem Detayları</h5>
            <div class="position-relative">
                <!-- Altta GERÇEK VERİ YOK: dekoratif sahte satırlar -->
                <table class="table align-middle mb-0" style="filter: blur(6px); user-select: none;" aria-hidden="true">
                    <thead class="table-light">
                        <tr><th>Tarih</th><th>Açıklama</th><th>Kategori</th><th>Tür</th><th class="text-end">Tutar</th></tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < 5; i++)
                        {
                            <tr>
                                <td>00.00.0000</td>
                                <td>-----</td>
                                <td>-----</td>
                                <td><span class="badge rounded-pill bg-secondary">----</span></td>
                                <td class="text-end">0.000,00 ₺</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <!-- Kilit mesajı -->
                <div class="position-absolute top-50 start-50 translate-middle text-center bg-white rounded-3 shadow-sm p-4">
                    <i class="bi bi-lock-fill fs-3" style="color:#b3423a;"></i>
                    <p class="mb-0 fw-semibold mt-2">İşlem detaylarını görüntüleme yetkiniz yok</p>
                    <small class="text-muted">Erişim için yöneticinizle iletişime geçin.</small>
                </div>
            </div>
        }
    </div>
</div>
@section Scripts {
    <script>
        // Hazır dönem butonları: tarihleri set edip formu gönderir.
        // Form submit edildiği için kategori ve tür seçimleri de birlikte gider.
        function setRange(start, end) {
            console.log("burdayim");
            console.log(start);
            document.getElementById('startDate').value = start;
            document.getElementById('endDate').value = end;
            document.getElementById('filterForm').submit();
        }
    </script>
}