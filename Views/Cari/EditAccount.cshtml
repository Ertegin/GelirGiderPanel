@model GelirGiderPanel.Models.CariAccount
@{
    ViewData["Title"] = "Cari Hesabı Düzenle";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header text-white" style="background-color:#14231f;">
                <span style="font-family:'Sora',sans-serif;">Cari Hesabı Düzenle</span>
            </div>
            <div class="card-body">
                <form asp-action="EditAccount" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CreatedAt" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="OpeningBalance" class="form-label"></label>
                        <input asp-for="OpeningBalance" class="form-control" type="number" step="0.01" />
                        <div class="form-text">
                            Devir bakiyesini değiştirmek tüm yürüyen bakiyeyi etkiler.
                        </div>
                        <span asp-validation-for="OpeningBalance" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Details" asp-route-id="@Model.Id"
                           class="btn btn-outline-secondary">İptal</a>
                        <button type="submit" class="btn text-white" style="background-color:#0e7a5f;">
                            Güncelle
                        </button>
                    </div>
                </form>
            </div>
            <div class="card-footer bg-white d-flex justify-content-start">
                <form asp-action="DeleteAccount" asp-route-id="@Model.Id" method="post"
                      onsubmit="return confirm('Hesap silinsin mi? Hareketi olan hesaplar pasife alınır.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger">Sil / Pasife Al</button>
                </form>
            </div>
        </div>
    </div>
</div>
