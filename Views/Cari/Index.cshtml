@* @model List<Code_First_2.Controllers.CariAccountSummaryVm> *@

@model GelirGiderPanel.Controllers.CariIndexVm
@{
    ViewData["Title"] = "Cari Hesaplar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0" style="font-family:'Sora',sans-serif;">Cari Hesaplar</h4>
    <a asp-action="CreateAccount" class="btn text-white" style="background-color:#0e7a5f;">
        <i class="bi bi-plus-lg me-1"></i> Yeni Cari Hesap
    </a>
</div>

@* Genel durum kartları *@
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Toplam Alacağınız</div>
                <div class="fs-4 fw-bold" style="color:#0e7a5f;">
                    @Model.TotalReceivable.ToString("N2") ₺
                </div>
                <div class="small text-muted">Müşterilerin size borcu</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Toplam Borcunuz</div>
                <div class="fs-4 fw-bold" style="color:#b3423a;">
                    @Model.TotalPayable.ToString("N2") ₺
                </div>
                <div class="small text-muted">Sizin müşterilere borcunuz</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100"
             style="border-left:4px solid @(Model.Net >= 0 ? "#0e7a5f" : "#b3423a") !important;">
            <div class="card-body">
                <div class="text-muted small">Net Durum</div>
                <div class="fs-4 fw-bold" style="color:@(Model.Net >= 0 ? "#0e7a5f" : "#b3423a");">
                    @Math.Abs(Model.Net).ToString("N2") ₺
                </div>
                <div class="small fw-semibold" style="color:@(Model.Net >= 0 ? "#0e7a5f" : "#b3423a");">
                    @(Model.Net >= 0 ? "ALACAKLISINIZ" : "BORÇLUSUNUZ")
                </div>
            </div>
        </div>
    </div>
</div>

@if (!Model.Accounts.Any())
{
    <div class="alert alert-light border">
        Henüz cari hesap yok. "Yeni Cari Hesap" ile ilk hesabınızı oluşturun.
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color:#f5f7f6;">
                    <tr>
                        <th>Hesap Adı</th>
                        <th>Açıklama</th>
                        <th class="text-center">Hareket</th>
                        <th class="text-end">Güncel Bakiye</th>
                        <th class="text-center">Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Accounts)
                    {
                        <tr class="@(a.IsActive ? "" : "opacity-50")">
                            <td>
                                <a asp-action="Details" asp-route-id="@a.Id"
                                   class="fw-semibold text-decoration-none" style="color:#14231f;">
                                    @a.Name
                                </a>
                            </td>
                            <td class="text-muted small">@a.Description</td>
                            <td class="text-center">@a.TransactionCount</td>
                            <td class="text-end fw-semibold"
                                style="color:@(a.Balance >= 0 ? "#0e7a5f" : "#b3423a");">
                                @a.Balance.ToString("N2") ₺
                                <div class="small fw-normal text-muted">
                                    @(a.Balance > 0 ? "Alacaklısınız" : a.Balance < 0 ? "Borçlusunuz" : "Kapalı")
                                </div>
                            </td>
                            <td class="text-center">
                                @if (a.IsActive)
                                {
                                    <span class="badge" style="background-color:#0e7a5f;">Aktif</span>
                                }
                                else
                                {

                                    <span class="badge bg-secondary">Pasif</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@a.Id"
                                   class="btn btn-sm btn-outline-secondary">Defter</a>
                                <a asp-action="EditAccount" asp-route-id="@a.Id"
                                   class="btn btn-sm btn-outline-secondary">Düzenle</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
