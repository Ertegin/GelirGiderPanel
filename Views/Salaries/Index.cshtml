<div class="card border-0 shadow-sm mb-4">
    <div class="card-body py-3">
        <form method="get" asp-action="Index" class="d-flex flex-wrap align-items-center gap-2">
            <div class="input-group input-group-sm" style="max-width:320px;">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" name="search" id="maasSearch" class="form-control"
                       placeholder="İsme göre ara…" value="@search" autocomplete="off"
                       oninput="maasLiveFilter()" />
            </div>
            <span class="small text-muted" id="maasResultInfo"></span>
        </form>
    </div>
</div>


@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4 col-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Personel Sayısı</div>
                <div class="fs-4 fw-bold" style="color:#14231f;" id="maasCountCard" >@Model.Count</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-6">
        <div class="card border-0 shadow-sm h-100"
             style="border-left:4px solid #b3423a !important;">
            <div class="card-body">
                <div class="text-muted small">Toplam Maaş</div>
                <div class="fs-4 fw-bold" style="color:#b3423a;" id="maasTotalCard">@total.ToString("N2") ₺</div>
            </div>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-light border">
        @if (!string.IsNullOrEmpty(search))
        {
            <text>"@search" aramasıyla eşleşen kayıt bulunamadı.</text>
        }
        else
        {
            <text>Henüz maaş kaydı yok. "Yeni Maaş" ile ekleyebilirsiniz.</text>
        }
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color:#f5f7f6;">
                    <tr>
                        <th>İsim</th>
                        <th class="text-end">Maaş</th>
                        <th>Açıklama</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr class="maas-row" data-name="@s.Name"
                            data-amount="@s.Amount.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)">

                            <td class="fw-semibold">@s.Name</td>
                            <td class="text-end fw-semibold" style="color:#b3423a;">
                                @s.Amount.ToString("N2") ₺
                            </td>
                            <td class="text-muted small">@s.Description</td>
                            <td class="text-end text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0"
                                        data-bs-toggle="modal" data-bs-target="#maasModal"
                                        data-id="@s.Id"
                                        data-name="@s.Name"
                                        data-amount="@s.Amount.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                        data-desc="@s.Description"
                                        onclick="maasFillForm(this)">
                                    Düzenle
                                </button>
                                <form asp-action="Delete" asp-route-id="@s.Id" method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('@s.Name maaş kaydı silinsin mi?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger py-0">Sil</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot style="background-color:#f5f7f6;">
                    <tr class="fw-bold">
                        <td>TOPLAM</td>
                        <td class="text-end" style="color:#b3423a;" id="maasFootTotal">@total.ToString("N2") ₺</td>
                        <td colspan="2"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <div class="alert alert-light border m-3 d-none" id="maasNoMatch">
            Aramanızla eşleşen kayıt bulunamadı.
        </div>
    </div>
}

@* ==================== MAAŞ MODALI ==================== *@
<div class="modal fade" id="maasModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:1rem;">
            <form asp-action="Save" method="post">
                <input type="hidden" name="Id" id="mId" value="0" />

                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="maasModalTitle"
                        style="font-family:'Sora',sans-serif;">
                        Yeni Maaş
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">İsim <span class="text-danger">*</span></label>
                        <input type="text" name="Name" id="mName" class="form-control"
                               placeholder="Örn: Ahmet Yılmaz" maxlength="150" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Maaş (TL) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">₺</span>
                            <input type="number" name="Amount" id="mAmount" class="form-control"
                                   min="0.01" step="0.01" placeholder="0,00" required />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Açıklama</label>
                        <textarea name="Description" id="mDesc" class="form-control" rows="2"
                                  maxlength="300" placeholder="Örn: Usta — haftalık ödeme"></textarea>
                    </div>
                </div>

                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        İptal
                    </button>
                    <button type="submit" class="btn text-white px-4" style="background-color:#14231f;">
                        <i class="bi bi-save me-1"></i> Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
            // ==================== CANLI İSİM FİLTRESİ ====================
        function maasLiveFilter() {
            console.log("filteleme--")
            const input = document.getElementById('maasSearch');
            // Türkçe harf güvenli küçültme: "AHMET".toLocaleLowerCase('tr') → "ahmet",
            // "IŞIK" → "ışık" (normal toLowerCase 'I'yı 'i' yapar, Türkçe'de yanlıştır)
            const term = input.value.trim().toLocaleLowerCase('tr');

            let visible = 0, totalAmount = 0;
            document.querySelectorAll('.maas-row').forEach(tr => {
                const name = (tr.dataset.name || '').toLocaleLowerCase('tr');
                const match = term === '' || name.includes(term);
                tr.classList.toggle('d-none', !match);
                if (match) {
                    visible++;
                    totalAmount += parseFloat(tr.dataset.amount) || 0;
                }
            });

            // Kartları ve tablo toplamını görünen satırlara göre güncelle
            const fmt = totalAmount.toLocaleString('tr-TR',
                { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';
            const countCard = document.getElementById('maasCountCard');
            const totalCard = document.getElementById('maasTotalCard');
            const footTotal = document.getElementById('maasFootTotal');
            if (countCard) countCard.textContent = visible;
            if (totalCard) totalCard.textContent = fmt;
            if (footTotal) footTotal.textContent = fmt;

            // Sonuç bilgisi + boş sonuç mesajı
            const info = document.getElementById('maasResultInfo');
            info.textContent = term === '' ? '' : `${visible} sonuç`;
            const noMatch = document.getElementById('maasNoMatch');
            if (noMatch) noMatch.classList.toggle('d-none', visible > 0 || term === '');

            // Excel/PDF linkleri yazılan aramayı taşısın
            const q = term === '' ? '' : ('?search=' + encodeURIComponent(input.value.trim()));
            const excel = document.getElementById('maasExcelLink');
            const pdf = document.getElementById('maasPdfLink');
            if (excel) excel.href = '/Salaries/ExportExcel' + q;
            if (pdf) pdf.href = '/Salaries/ExportPdf' + q;
        }

        // Sayfa sunucu filtresiyle açıldıysa (URL'de ?search=) durumu senkronla
        document.addEventListener('DOMContentLoaded', maasLiveFilter);

        function maasResetForm() {
            document.getElementById('maasModalTitle').textContent = 'Yeni Maaş';
            document.getElementById('mId').value = '0';
            document.getElementById('mName').value = '';
            document.getElementById('mAmount').value = '';
            document.getElementById('mDesc').value = '';
        }

        function maasFillForm(btn) {
            maasResetForm();
            document.getElementById('maasModalTitle').textContent = 'Maaşı Düzenle';
            const d = btn.dataset;
            document.getElementById('mId').value = d.id;
            document.getElementById('mName').value = d.name || '';
            document.getElementById('mAmount').value = d.amount || '';
            document.getElementById('mDesc').value = d.desc || '';
        }
    </script>
}
