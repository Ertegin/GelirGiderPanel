<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gelir Gider Paneli</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

    <style>
        :root {
            --ink: #1b2733;          /* koyu lacivert-gri */
            --paper: #f5f7f6;        /* açık zemin */
            --ledger-green: #0e7a5f; /* muhasebe defteri yeşili (gelir) */
            --ledger-red: #b3423a;   /* kırmızı mürekkep (gider) */
            --sidebar-bg: #14231f;   /* koyu yeşil-siyah */
            --card-border: #e3e8e6;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--paper);
            color: var(--ink);
        }

        h1, h2, h3, h4, h5, .display-font {
            font-family: 'Sora', sans-serif;
        }

        /* ---- Sidebar ---- */
        .sidebar {
            width: 240px;
            min-height: 100vh;
            background: var(--sidebar-bg);
            position: fixed;
            top: 0; left: 0;
            padding: 1.5rem 1rem;
            z-index: 1000;
        }

        .sidebar .brand {
            color: #fff;
            font-family: 'Sora', sans-serif;
            font-weight: 700;
            font-size: 1.15rem;
            letter-spacing: -0.02em;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: .6rem;
            margin-bottom: 2rem;
        }

        .sidebar .brand .logo-badge {
            background: var(--ledger-green);
            border-radius: 8px;
            width: 34px; height: 34px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1rem;
        }

        .sidebar .nav-link {
            color: #9fb3ac;
            border-radius: 8px;
            padding: .6rem .9rem;
            margin-bottom: .25rem;
            font-weight: 500;
            display: flex; align-items: center; gap: .65rem;
            transition: background .15s, color .15s;
        }

        .sidebar .nav-link:hover { color: #fff; background: rgba(255,255,255,.06); }
        .sidebar .nav-link.active { color: #fff; background: var(--ledger-green); }

        /* ---- İçerik ---- */
        .main-content {
            margin-left: 240px;
            padding: 2rem 1.1rem;
        }

        .card {
            border: 1px solid var(--card-border);
            border-radius: 14px;
            box-shadow: 0 1px 3px rgba(27,39,51,.05);
        }

        .btn-primary {
            background: var(--ledger-green);
            border-color: var(--ledger-green);
        }
        .btn-primary:hover, .btn-primary:focus {
            background: #0a5f4a;
            border-color: #0a5f4a;
        }

        .text-income { color: var(--ledger-green); }
        .text-expense { color: var(--ledger-red); }

        .badge-income  { background: rgba(14,122,95,.12);  color: var(--ledger-green); }
        .badge-expense { background: rgba(179,66,58,.12);  color: var(--ledger-red); }

        /* ---- Mobil ---- */
        @@media (max-width: 991px) {
            .sidebar { width: 100%; min-height: auto; position: static; padding: 1rem; }
            .sidebar .nav { flex-direction: row !important; flex-wrap: wrap; }
            .main-content { margin-left: 0; padding: 1.25rem; }
        }
    </style>
</head>
<body>
    <!-- ======= SIDEBAR ======= -->
    <nav class="sidebar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <span class="logo-badge"><i class="bi bi-journal-check"></i></span>
            Bütçe Hesap<span style="color:#5fbfa4">Guven</span>
        </a>

        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                   asp-controller="Home" asp-action="Index">
                    <i class="bi bi-grid-1x2"></i> Panel
                </a>
            </li>
            
            
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Transactions" ? "active" : "")"
                       asp-controller="Transactions" asp-action="Index">
                        <i class="bi bi-arrow-left-right"></i> İşlemler
                    </a>
                </li>
            
           
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active" : "")"
                   asp-controller="Categories" asp-action="Index">
                    <i class="bi bi-tags"></i> Kategoriler
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")"
                   asp-controller="Reports" asp-action="Index">
                    <i class="bi bi-file-earmark-bar-graph"></i> Raporlar
                </a>
            </li>
            
            
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Cari" ? "active" : "")"
                   asp-controller="Cari" asp-action="Index">
                        <i class="bi bi-journal-text me-2"></i> Cari
                </a>
            </li>
                
            
            <a class="nav-link" asp-controller="Salaries" asp-action="Index">
                <i class="bi bi-people me-2"></i> Maaşlar
            </a>
            @if (User.IsInRole("Admin"))
            {
                <a class="nav-link" asp-controller="LoginLogs" asp-action="Index">
                    <i class="bi bi-clock-history me-2"></i> Giriş Kayıtları
                </a>
            }
            

            @if (User.Identity.IsAuthenticated)
            {
                <div class="mt-4 pt-3" style="border-top: 1px solid rgba(255,255,255,.1);">
                    <div class="text-white-50 small px-2 mb-2">
                        <i class="bi bi-person-circle me-1"></i> @User.Identity.Name
                    </div>
                    <form asp-controller="Auth" asp-action="LogOut" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-light w-100">
                            <i class="bi bi-box-arrow-right me-1"></i> Çıkış Yap 
                        </button>
                    </form>
                </div>
            }
        </ul>
    </nav>

    <!-- ======= ANA İÇERİK ======= -->
    <main class="main-content">
        @* Başarı / hata bildirimleri *@
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-1"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-1"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
 <script>
    // Sağ tıkl engelle
    document.addEventListener('contextmenu', function (e) {
        e.preventDefault();
    });

    document.addEventListener('keydown', function (e) {
        const key = e.key.toLowerCase();

        if (
            e.key === 'F12' ||
            (e.ctrlKey && key === 'u') ||
            (e.ctrlKey && e.shiftKey && key === 'i') ||
            (e.ctrlKey && e.shiftKey && key === 'j') ||
            (e.ctrlKey && key === 's')
        ) {
            e.preventDefault();
            e.stopPropagation();
            return false;
        }
    });
</script> 